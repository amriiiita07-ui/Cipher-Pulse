# Backend Configuration
DATABASE_URL=postgresql://cipherpulse:cipherpulse_secret@localhost:5432/cipherpulse
MODEL_VERSION=v1-tfidf-lr
RISK_THRESHOLD=60
PYTHONIOENCODING="utf-8"

# Stripe Payments API Credentials (Backend)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AI Model Keys (Optional/Backend)
OPENAI_API_KEY=sk-proj-your_openai_key
GEMINI_API_KEY=AIzaSy_your_gemini_key

# Frontend Configuration (Stripe)
# Vite requires VITE_ prefix for client-side environment variables
